# Server-only key. Keep the real value in an untracked .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional: use a different model for the larger structured map response.
OPENAI_MAP_MODEL=gpt-6-astra
# Optional image model for the transparent Level 2 hero.
OPENAI_IMAGE_MODEL=gpt-image-1
PORT=3001
# Set to true only when testing live API interpretation; restart Vite after changing it.
VITE_REQUIRE_AI=false
